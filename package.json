{
  "name": "bible-connections",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive exploration of 344,799 biblical cross-references (OpenBible.info) as arcs, networks and statistics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "data": "node scripts/build-data.ts",
    "data:validate": "node scripts/validate-data.ts",
    "predev": "node scripts/ensure-data.ts",
    "dev": "vite",
    "prebuild": "node scripts/ensure-data.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "versification": "node scripts/derive-versification.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "d3": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/d3": "7.4.3",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
